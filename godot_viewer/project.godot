; Track & Field Manager - Race Viewer (Godot 4.3+)
config_version=5

[application]

config/name="TF Manager - Race Viewer"
run/main_scene="res://scenes/Stadium.tscn"
config/features=PackedStringArray("4.3", "Mobile")

[autoload]

DatabaseManager="*res://autoload/DatabaseManager.gd"
RaceController="*res://autoload/RaceController.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.08, 1)
